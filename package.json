{
  "name": "dafeiyu-douyin",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "大肥鱼·抖音版：用本机真实 Chrome 驱动抖音的 DSH 插件 —— 看推荐/热榜/搜索/评论/主页，点赞收藏关注评论，把本地视频传进创作者中心；写动作过权限闸，发布必须人类点头。",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "douyin", "tiktok", "playwright", "agent"],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": { "optional": true }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings-general"]
    }
  },
  "files": ["index.js", "client.js", "lib", "icon.svg", "cordis.patch.yml", "README.md", "LICENSE"]
}
